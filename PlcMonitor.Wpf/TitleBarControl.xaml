<UserControl x:Class="PlcMonitor.Wpf.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlcMonitor.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border x:Name="TitleBarBorder"
            Background="#2D2D2D"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 图标区域 -->
            <Image x:Name="IconImage" Source="/xuu0w-01fvm-001.ico"
                   Width="20" Height="20"
                   Margin="10,0"
                   Visibility="Collapsed" />

            <!-- 标题文字 -->
            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Text="应用程序"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <!-- 窗口控制按钮 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">

                <!-- 最小化 -->
                <Button x:Name="MinimizeButton"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        ToolTip="最小化">
                    <Path Stroke="White" StrokeThickness="1.5"
                          Data="M6,15 H26"
                          Stretch="Uniform"
                          Margin="0,0,0,4" />
                </Button>

                <!-- 最大化/还原 -->
                <Button x:Name="MaximizeButton"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        ToolTip="最大化">
                    <Path x:Name="MaximizePath"
                          Stroke="White" StrokeThickness="1.5"
                          Data="M8,6 H24 V22 H8 Z"
                          Stretch="Uniform"
                          Margin="0,0,0,2" />
                </Button>

                <!-- 关闭 -->
                <Button x:Name="CloseButton"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Path Stroke="White" StrokeThickness="1.5"
                          Data="M8,8 L24,24 M24,8 L8,24"
                          Stretch="Uniform"
                          Margin="0,0,0,2" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
