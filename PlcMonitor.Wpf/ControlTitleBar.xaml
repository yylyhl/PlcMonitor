<UserControl x:Class="PlcMonitor.Wpf.ControlTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlcMonitor.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border x:Name="TitleBarBorder"
            Background="#2D2D2D"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage" Source="xuu0w-01fvm-001.ico" Width="20" Height="20" Margin="10,0"/>

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Text="窗口标题"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Width="40" Height="35" Padding="14,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        ToolTip="最小化">
                    <Path Stroke="White" StrokeThickness="1"
                          Data="M0,0 H10"
                          Stretch="Uniform"/>
                </Button>

                <Button x:Name="MaximizeButton"
                        Width="40" Height="35" Padding="15,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        ToolTip="最大化">
                    <Path x:Name="MaximizePath"
                          Stroke="White" StrokeThickness="1"
                          Data="M0,0 H10 V10 H0 Z"
                          Stretch="Uniform"/>
                </Button>

                <Button x:Name="CloseButton"
                        Width="40" Height="35" Padding="15,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Path Stroke="White" StrokeThickness="1"
                          Data="M2,2 L12,12 M12,2 L2,12"
                          Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
