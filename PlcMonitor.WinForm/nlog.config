<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" 
	  throwExceptions="true"
      internalLogLevel="debug" 
	  internalLogFile="D:\nuget\nlog_AppName-internal.log"
	  internalLogToConsole="true"
	  RemoveLoggerFactoryFilter="false">
	<extensions>
		<add assembly="NLog.Mongo"/>
	</extensions>
	<targetsOld async="true">
		<target name="error" xsi:type="File" fileName="logs/${shortdate}.txt"
				archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
				archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
				autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
				layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message} ${exception}"/>

		<target name="warn" xsi:type="File" fileName="logs/${shortdate}.txt"
				archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
				archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
				autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
				layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message}"/>

		<target name="file" xsi:type="File" fileName="logs/${shortdate}.txt"
				archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
				archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
				autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
				layout="${time} [${level:uppercase=true}] Thread:${threadid} ${message}"/>

		<target name="console" xsi:type="Console"
				layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message} ${exception:format=tostring}"/>
	</targetsOld>

	<targets>
		<target name="errorAsync" xsi:type="AsyncWrapper" queueLimit="10000">
			<target name="error" xsi:type="File" fileName="logs/${shortdate}.txt"
					archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
					archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
					autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
					layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message} ${exception}"/>

		</target>
		<target name="warnAsync" xsi:type="AsyncWrapper" queueLimit="10000">
			<target name="warn" xsi:type="File" fileName="logs/${shortdate}.txt"
					archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
					archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
					autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
					layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message}"/>

		</target>
		<target name="fileAsync" xsi:type="AsyncWrapper" queueLimit="10000">
			<target name="file" xsi:type="File" fileName="logs/${shortdate}.txt"
					archiveAboveSize="10485760" maxArchiveFiles="300" maxArchiveDays="30"
					archiveEvery="Day" archiveFileName="logs/nlog-${shortdate}.{#}.txt"
					autoFlush="false" keepFileOpen="true" openFileFlushTimeout="2" openFileCacheTimeout="60" bufferSize="32768"
					layout="${time} [${level:uppercase=true}] Thread:${threadid} ${message}"/>

		</target>
		<target name="consoleAsync" xsi:type="AsyncWrapper" queueLimit="5000">
			<target name="console" xsi:type="Console"
					layout="${time} [${level:uppercase=true}] Thread:${threadid} ${logger}: ${message} ${exception:format=tostring}"/>
		</target>
		<!--把日志输出到MongoDB 需引用NLog.Mongo；需定时调用NLog.LogManager.Configuration.Install(new NLog.Config.InstallationContext())以执行install-command语句建表；-->
		<target name="mongodb" 
				xsi:type="Mongo"
				databaseName="TransLog"
				collectionName="Plc"
				connectionString22="mongodb://admin:adminpassword@192.168.100.209:27017?authSource=admin"
				connectionstring="Data Source=192.168.100.209;Initial Catalog=TransLog;User ID=admin;Password=adminpassword;Persist Security Info=True;Max Pool Size=50;Min Pool Size=0;Connection Lifetime=300;"
				includeDefaults="false"
				cappedCollectionSizeTMP="1024576000"
				cappedCollectionMaxItemsTMP="1000000">

			<field name="logtime" layout="${longdate}"/>
			<field name="processName" layout="${processname:fullName=false}"/>
			<field name="hostname" layout="${hostname}"/>
			<field name="processId" layout="${processid}" bsonType="Int32" />
			<field name="thread" layout="${threadid}" bsonType="Int32" />
			<field name="level" layout="${level}"/>
			<field name="message" layout="${message}" />
			<field name="logger" layout="${logger}"/>
			<field name="error" layout="${exception}" />
			<!--property放 Http/Web 相关扩展字段；依赖 NLog.Web.AspNetCore 包，非此包则不写日志不报错；-->
			<!--<property name="RequestIP" layout="${aspnet-request-ip}" />
			<property name="UserName" layout="${aspnet-user-identity}" />
			<property name="BaseDir" layout="${aspnet-appbasepath}"/>
			<property name="QueryUrl" layout="${aspnet-request-url}"/>
			<property name="Method" layout="${aspnet-request-method}"/>
			<property name="Controller" layout="${aspnet-mvc-controller}"/>
			<property name="Action" layout="${aspnet-mvc-action}" />
			<property name="FormContent" layout="${aspnet-request-form}"/>
			<property name="QueryContent" layout="${aspnet-request-querystring}"/>-->
		</target>
	</targets>

	<rules>
		<logger name="Microsoft.AspNetCore.*" finalMinLevel="Warn" writeTo="blackhole"/>
		<logger name="System.*" finalMinLevel="Warn" writeTo="blackhole"/>
		<logger name="Microsoft.Hosting.Lifetime" finalMinLevel="Info" writeTo="blackhole"/>
		
		<logger name="*" minlevel="Info" writeTo="consoleAsync" />
		<logger name="*" minlevel="Error" writeTo="errorAsync" />
		<logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="warnAsync" />
		<logger name="*" minlevel="Debug" writeTo="fileAsync" />
		<logger name="*" minlevel="Debug" writeTo="mongodb"/>
	</rules>
</nlog>